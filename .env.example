APP_NAME="Task Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Where the Next.js app is served; invitation links point here.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the default. For a zero-setup local database use:
#   DB_CONNECTION=sqlite  (and remove the other DB_* lines; database/database.sqlite is created on demand)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=task_management_app
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live board updates: `reverb` with the REVERB_* values below, and
# `php artisan reverb:start` running. With `log` or `null` boards update on reload only.
BROADCAST_CONNECTION=log
# Any random strings; the web app needs the same REVERB_APP_KEY.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where this API sends events: the Reverb server (`reverb:start` listens on 0.0.0.0:8080).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated origins allowed to call the API from a browser (the Next.js app).
# Leave unset to allow any origin in local development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OAuth for MCP clients (Claude, Cursor, ...) signs tokens with an RSA key pair.
# Locally, `php artisan passport:keys` writes storage/oauth-*.key instead. With
# neither, OAuth is off and the MCP server takes API tokens only. In an env
# file, put each key on one line, with \n for its line breaks.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production: MAIL_MAILER=resend with the API key below (free tier: 3,000/month).
RESEND_KEY=

# Billing (Stripe via Laravel Cashier). Use test-mode keys locally.
STRIPE_KEY=
STRIPE_SECRET=
# Signing secret of the webhook endpoint (`php artisan cashier:webhook`, or
# printed by `stripe listen`). When empty, webhook signatures are not checked.
STRIPE_WEBHOOK_SECRET=
# A recurring, monthly, per-unit Price; the quantity is the member count.
STRIPE_PRICE_ID=
# Keeps the webhook under /api so the proxy needs no extra route:
# POST /api/stripe/webhook
CASHIER_PATH=api/stripe
CASHIER_CURRENCY=usd
# Members a workspace may have without paying, and the displayed seat price.
BILLING_FREE_SEATS=3
BILLING_SEAT_PRICE_CENTS=800

# Where scheduled commands write their output (discarded when empty). The
# production scheduler container uses /proc/1/fd/1, its own log.
SCHEDULE_OUTPUT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
